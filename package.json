{
  "name": "vulcania",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@vulcania/app": "workspace:*",
    "@vulcania/animation": "workspace:*",
    "@vulcania/fonts": "workspace:*",
    "@vulcania/gpu": "workspace:*",
    "@vulcania/layout": "workspace:*",
    "@vulcania/widgets": "workspace:*",
    "@vulcania/bindings": "workspace:*",
    "@vulcania/core": "workspace:*",
    "@vulcania/interactions": "workspace:*",
    "@vulcania/paint": "workspace:*",
    "@vulcania/devtools": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx,md,mdx,json}": [
      "eslint --fix",
      "bun fmt"
    ],
    "tools/**/*.{js,jsx,ts,tsx,md,mdx,json}": [
      "eslint --fix",
      "bun fmt"
    ]
  },
  "scripts": {
    "build": "bun run bin/build.ts",
    "cleanup": "bun run bin/cleanup.ts",
    "codegen:all": "bun run tools/codegen/src/index.ts all",
    "codegen:image": "bun run tools/codegen/src/index.ts image",
    "codegen:mixer": "bun run tools/codegen/src/index.ts mixer",
    "codegen:sdl": "bun run tools/codegen/src/index.ts sdl",
    "codegen:ttf": "bun run tools/codegen/src/index.ts ttf",
    "smoke": "bun run scripts/smoke.ts",
    "vendor": "bun run scripts/vendor-headers.ts",
    "smoke:node": "node scripts/smoke.ts",
    "hello": "bun run examples/hello.ts",
    "typecheck": "bun check",
    "lint": "eslint .",
    "benchmark": "bun run examples/benchmark.ts"
  }
}
